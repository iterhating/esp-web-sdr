# Downloaded CI artifacts
/artifacts/
/test-results/

# firmware/ and vendor licenses are intentional release inputs.

# Python development files
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Editor and operating-system files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.log


# Calibration captures stay local: raw I/Q recordings and their results can
# hold nearby device addresses, decoded beacons and RF-environment surveys.
# Only the tools and their documentation are tracked.
/calibration/*
!/calibration/*.py
!/calibration/README.md

# Firmware build output (binaries ship through firmware/ and its manifest).
/csi-firmware/build/
/csi-firmware/sdkconfig
/csi-firmware/sdkconfig.old
/csi-firmware/managed_components/
/csi-firmware/dependencies.lock
